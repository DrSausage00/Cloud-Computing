# Kopieren nach ".env" und mit echten Werten fuellen.
# Diese Datei (.env.example) darf ins Git, ".env" selbst NICHT.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_DATA_BUCKET=mes-data

# Defaults passen in der Regel, nur bei Bedarf anpassen:
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=10
S3_RETRY_MAX_ATTEMPTS=1
S3_USE_LISTINGS_CACHE=false
# Auf das Readiness-Probe-Intervall abstimmen (>= periodSeconds empfohlen,
# sonst trifft die eigene Probe eines Pods immer einen kalten Cache)
S3_CACHE_TTL_SECONDS=5

# Optional - nur setzen, wenn ein geteilter Cache ueber mehrere Pods
# hinweg (Redis) genutzt werden soll. Bleibt REDIS_HOST leer, wird der
# einfache In-Memory-Cache pro Pod verwendet (aktuelles Standardverhalten).
# REDIS_HOST=redis
# REDIS_PORT=6379